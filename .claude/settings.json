{
  "model": "opusplan",
  "effortLevel": "medium",
  "maxEffortLevel": "xhigh",
  "subagentPromptCacheTtl": "5m",
  "extraKnownMarketplaces": {
    "dev-workflow-plugins": { "source": { "source": "github", "repo": "muric-dev/dev-workflow-plugins" } }
  },
  "enabledPlugins": { "usage-ledger@dev-workflow-plugins": true },
  "permissions": {
    "allow": [
      "Bash(make test)",
      "Bash(make check)",
      "Bash(make sizecheck)",
      "Bash(git status)",
      "Bash(git status *)",
      "Bash(git log *)",
      "Bash(git diff)",
      "Bash(git diff *)"
    ],
    "deny": [
      "Read(~/Library/Application Support/clarivident/**)",
      "Edit(~/Library/Application Support/clarivident/**)",
      "Read(./ledger/usage.json)",
      "Bash(security find-generic-password*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(git stash:*)",
      "Bash(git reset:*)",
      "Bash(git rebase:*)",
      "Bash(git merge:*)",
      "Bash(gh pr create:*)",
      "Bash(gh pr merge:*)",
      "Edit(.git/**)",
      "Write(.git/**)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/scripts/hook-go.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/scripts/hook-stop.sh"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/scripts/hook-guard.sh"
          }
        ]
      }
    ]
  }
}
